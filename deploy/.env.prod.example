# Docker image names and tags are written by Jenkins to .images.env.
FRONTEND_PORT=80

# PostgreSQL
POSTGRES_DB=jrawler_db
POSTGRES_USER=jrawler_user
POSTGRES_PASSWORD=change-me

# Redis
REDIS_PASSWORD=

# Backend
CRAWLER_ENABLED=true
JAVA_OPTS=-Xms256m -Xmx768m

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_CHAT_ID=
