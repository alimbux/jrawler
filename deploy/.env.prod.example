# Docker images are written by Jenkins on every deployment.
BACKEND_IMAGE=registry.digitalocean.com/YOUR_REGISTRY/jrawler-backend
FRONTEND_IMAGE=registry.digitalocean.com/YOUR_REGISTRY/jrawler-frontend
IMAGE_TAG=latest
FRONTEND_PORT=80

# PostgreSQL
POSTGRES_DB=jrawler_db
POSTGRES_USER=jrawler_user
POSTGRES_PASSWORD=change-me

# Redis
REDIS_PASSWORD=

# Backend
CRAWLER_ENABLED=true
JAVA_OPTS=-Xms256m -Xmx768m

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_CHAT_ID=
